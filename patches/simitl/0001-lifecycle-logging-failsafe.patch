diff --git a/src/util/simitl_log.h b/src/util/simitl_log.h
new file mode 100644
index 0000000..5af0461
--- /dev/null
+++ b/src/util/simitl_log.h
@@ -0,0 +1,14 @@
+#ifndef SIMITL_LOG_H
+#define SIMITL_LOG_H
+
+#include <fmt/format.h>
+
+extern "C" int libfpv_bf_printf(const char *fmt, ...);
+
+// Routes SimITL's console output to the embedding library's logger.
+template <typename... Args>
+inline void simitl_log(fmt::format_string<Args...> f, Args&&... args) {
+  libfpv_bf_printf("%s", fmt::format(f, std::forward<Args>(args)...).c_str());
+}
+
+#endif
