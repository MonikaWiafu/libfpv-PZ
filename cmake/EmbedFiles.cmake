# Embeds files into a generated C++ source as byte arrays.
#   libfpv_embed_files(<out.cpp> <symbol prefix> <base dir> <files...>)
# Generates: const fpv::EmbeddedFile <prefix>[]; const size_t <prefix>Count;
# where each entry has the path relative to <base dir>.
function(libfpv_embed_files out prefix base)
  set(_body "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include \"util/embedded.h\"\nnamespace fpv {\n")
  set(_table "")
  set(_i 0)
  foreach(_f IN LISTS ARGN)
    file(RELATIVE_PATH _rel "${base}" "${_f}")
    file(READ "${_f}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _body "static const unsigned char ${prefix}_${_i}[] = {${_bytes}0x00};\n")
    string(APPEND _table "  {\"${_rel}\", ${prefix}_${_i}, ${_size}},\n")
    math(EXPR _i "${_i} + 1")
  endforeach()
  string(APPEND _body "extern const EmbeddedFile ${prefix}[] = {\n${_table}};\nextern const size_t ${prefix}Count = ${_i};\n}\n")
  file(WRITE "${out}.tmp" "${_body}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${out}.tmp" "${out}")
endfunction()
